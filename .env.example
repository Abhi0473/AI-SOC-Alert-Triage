# Copy this file to .env and fill in keys you have. Every key below is OPTIONAL --
# the project runs end-to-end in mock mode with none of them set.

# Enables live Claude analysis in src/ai_analyst.py instead of the templated mock.
ANTHROPIC_API_KEY=

# Enables live IOC reputation lookups in src/enrichment.py instead of the local
# mock threat-intel DB. Get a free key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
